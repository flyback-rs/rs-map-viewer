{
  "name": "rs-map-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "start": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "lint": "prettier --write \"./**/*.{js,ts,jsx,tsx,css,md}\"",
    "prepare": "husky",
    "download-caches": "node scripts/download-caches.js",
    "update-var-names": "node scripts/update-var-names.js",
    "export-textures": "tsx scripts/cache/export-textures.ts",
    "export-height-map": "tsx scripts/cache/export-height-map.ts"
  },
  "dependencies": {
    "@foxglove/wasm-bz2": "^0.3.0",
    "denque": "^2.1.0",
    "fflate": "^0.8.3",
    "gl-matrix": "^3.4.4",
    "java-random": "^0.4.0",
    "leva": "^0.10.1",
    "picogl": "^0.17.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-joystick-component": "^6.2.1",
    "react-modal": "^3.16.3",
    "react-router": "^8.4.0",
    "react-select": "^5.10.2",
    "usehooks-ts": "^3.1.1",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "adm-zip": "^0.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,css,md}": "prettier --write"
  }
}
